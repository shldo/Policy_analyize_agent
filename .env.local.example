# Local-only configuration. Never use these development values on a public server.
COMPOSE_PROJECT_NAME=policy-research-agent-local
APP_ENV_FILE=.env.local
DB_BIND_ADDRESS=127.0.0.1
DB_PORT=55432
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
DB_PASSWORD=local-policy-development
APP_NAME="Policy Research Agent"
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api/v1
APP_SECRET=local-policy-development-only-not-for-public-deployment
CRAWLING_ENABLED=false
DOCUMENT_STORAGE_DIR=data/pdfs
VECTOR_INDEX_DIR=data/vector_index
