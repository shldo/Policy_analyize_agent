APP_NAME="Policy in Action Library Backend"
APP_ENV=production
APP_DEBUG=false
API_V1_PREFIX=/api/v1

DATABASE_ENABLED=true
# When running via docker compose, DATABASE_URL is injected from compose.yaml (points to db:5432).
# Only set this manually when running the backend outside of Docker.
DATABASE_URL=postgresql+asyncpg://appuser:replace-with-database-password@localhost:5432/testdb

CRAWLING_ENABLED=false
DOCUMENT_STORAGE_DIR=data/pdfs
VECTOR_INDEX_DIR=data/vector_index

APP_SECRET=replace-with-a-long-random-secret
REGISTRATION_ENABLED=false
RAG_CLAIM_BINDING_ENABLED=false
CONTROLLED_RETRIEVAL_ENABLED=false
COMPOUND_RETRIEVAL_ENABLED=false
CHILD_SELECTION_STRATEGY=reranker_top_k
RAG_PACKING_POLICY=original
RAG_ALLOW_PARTIAL_ANSWERS=true
