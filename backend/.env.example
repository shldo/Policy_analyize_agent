APP_NAME=AI Policy Research Platform
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Crawling is disabled by default so the demo cannot contact websites accidentally.
CRAWLING_ENABLED=false
DEFAULT_REQUEST_TIMEOUT_SECONDS=30
DEFAULT_MAX_PAGES=100
DEFAULT_CONCURRENCY=3
USER_AGENT=AI-Policy-Research-Bot/0.1 (+contact@example.com)

# PostgreSQL/pgvector reservation. Set DATABASE_ENABLED=true when the DB is ready.
DATABASE_ENABLED=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_policy
DATABASE_POOL_PRE_PING=false
PERSISTENCE_BACKEND=database

# Durable demo storage used until PostgreSQL repositories are implemented.
DOCUMENT_STORE_PATH=data/state/documents.json

# Local semantic embedding model. The configured model must output 384 dimensions
# to match database/init.sql (vector(384)).
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
DEFAULT_EMBEDDING_DIMENSIONS=384
MODEL_CACHE_DIR=data/model_cache

# Generation context uses model tokens, not bytes. Install the tokenizer first:
# python -m app.core.tokenizer_assets
RAG_MAX_CONTEXT_TOKENS=6000
# Experimental English lexical recall. Keep off: CS07/MC04 regressed at 40.
CHILD_LEXICAL_CANDIDATE_K=0
# Candidate compound-query coverage; enable only in isolated regression first.
COMPOUND_RETRIEVAL_ENABLED=false
CONTROLLED_RETRIEVAL_ENABLED=false
PARENT_CONTEXT_K=8
MAX_PARENTS_PER_DOCUMENT=5
RAG_TOKENIZER_PATH=data/tokenizers/deepseek-v4/tokenizer.json

# OCR support for scanned/image-only PDF pages. Requires the tesseract-ocr
# system binary (see Dockerfile / README) in addition to the pip package.
OCR_MIN_TEXT_CHARS=20
OCR_LANGUAGES=eng

# Optional fallback provider.
FIRECRAWL_API_KEY=
